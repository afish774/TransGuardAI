{
  "name": "transguard-ai",
  "version": "2.0.0",
  "description": "TransGuard AI — 6-pillar AI surveillance platform with real-time edge detection, WebRTC streaming, and operator dashboard.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "python tests/test_fusion_detectors.py && jest --config jest.config.js --forceExit --detectOpenHandles",
    "test:python": "python tests/test_fusion_detectors.py",
    "test:backend": "jest --config jest.config.js --forceExit --detectOpenHandles",
    "test:coverage": "jest --config jest.config.js --forceExit --detectOpenHandles --coverage",
    "lint": "npx eslint .",
    "build:frontend": "cd frontend && npm install && npm run build"
  },
  "keywords": [
    "surveillance",
    "ai",
    "yolo",
    "webrtc",
    "safety"
  ],
  "author": "TransGuard AI",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@mermaid-js/mermaid-cli": "^11.17.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "joi": "^18.2.8",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.4",
    "multer": "^2.3.0",
    "node-cron": "^4.6.0",
    "socket.io": "^4.8.3",
    "uuid": "^14.0.2",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "jest": "^30.5.1",
    "mongodb-memory-server": "^10.4.3",
    "supertest": "^7.2.2"
  }
}
