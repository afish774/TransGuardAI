# ==========================================
# TRANS GUARD AI — Node.js Backend Dockerfile
# ==========================================
# Multi-stage build: install deps + build frontend, then run lean.
#
# Build:
#   docker build -f Dockerfile.backend -t transguard-backend .
#
# Run:
#   docker run -p 5000:5000 \
#     -e MONGO_URI=mongodb://mongo:27017/transguard \
#     -e JWT_SECRET=your-secret \
#     transguard-backend
# ==========================================

# --- Stage 1: Build frontend ---
FROM node:20-slim AS frontend-builder

WORKDIR /app/frontend
COPY frontend/package*.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ .
RUN npm run build

# --- Stage 2: Install backend deps ---
FROM node:20-slim AS backend-builder

WORKDIR /app
COPY package*.json ./
RUN npm ci --production --no-audit --no-fund

# --- Stage 3: Runtime ---
FROM node:20-slim AS runtime

# Security: run as non-root user
RUN groupadd -r transguard && useradd -r -g transguard -m transguard

WORKDIR /app

# Copy backend dependencies
COPY --from=backend-builder /app/node_modules ./node_modules

# Copy backend source
COPY package.json ./
COPY server.js ./
COPY routes/ ./routes/
COPY services/ ./services/
COPY middleware/ ./middleware/
COPY models/ ./models/
COPY jobs/ ./jobs/
COPY utils/ ./utils/

# Copy built frontend
COPY --from=frontend-builder /app/frontend/dist ./frontend/dist

# Create upload directories
RUN mkdir -p uploads/evidence uploads/watchlist && \
    chown -R transguard:transguard /app

USER transguard

ENV NODE_ENV=production
ENV PORT=5000

EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD node -e "fetch('http://localhost:5000/api/health').then(r => r.ok ? process.exit(0) : process.exit(1)).catch(() => process.exit(1))"

CMD ["node", "server.js"]
