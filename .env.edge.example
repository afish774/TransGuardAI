# ==========================================
# TRANS GUARD AI — Edge Engine Environment
# ==========================================
# Copy to .env.edge and fill in real values.
# Used by: docker compose --profile full up
# Also used by: python trans_guard_engine.py (reads os.getenv)

# Backend Connection
BACKEND_URL=http://localhost:5000

# Edge Node Authentication (must match DEFAULT_EDGE_API_KEY in backend .env)
EDGE_API_KEY=CHANGE_ME_match_your_backend_key

# Camera Source
# RTSP stream:
RTSP_URL=rtsp://192.168.1.100:554/stream
# USB webcam (index):
# RTSP_URL=0
# IP camera HTTP stream:
# RTSP_URL=http://192.168.1.50:8080/video

# Camera Identity
CAMERA_ID=cam0

# Frame settings
FRAME_WIDTH=1280
FRAME_HEIGHT=720
FRAME_FPS=25

# YOLO model weights
YOLO_MODEL=yolov8n.pt
YOLO_CONF=0.45
WEAPON_MODEL=yolov8n-weapons.pt
