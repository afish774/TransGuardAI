# ==========================================
# TRANS GUARD AI — Edge Engine Environment
# ==========================================
# Copy to .env.edge and fill in real values.
# Loaded by the native Python launcher. Docker Compose injects environment
# variables directly; values in the process environment take precedence.

# Backend Connection
BACKEND_URL=http://127.0.0.1:5000

# Edge Node Authentication (must match DEFAULT_EDGE_API_KEY in backend .env)
EDGE_API_KEY=CHANGE_ME_match_your_backend_key

# Camera Source
# RTSP stream:
RTSP_URL=rtsp://192.168.1.100:554/stream
# USB webcam (index):
# RTSP_URL=0
# IP camera HTTP stream:
# RTSP_URL=http://192.168.1.50:8080/video

# Camera Identity
CAMERA_ID=cam0

# Frame settings
FRAME_WIDTH=1280
FRAME_HEIGHT=720
FRAME_FPS=25

# YOLO model weights
YOLO_MODEL=yolov8n.pt
YOLO_CONF=0.45
WEAPON_MODEL=yolov8n-weapons.pt
WEAPON_CONF=0.38
WEAPON_CONFIRM_FRAMES=4
FACE_MATCH_TOLERANCE=0.50
CROWD_THRESHOLD=8
CROWD_FRAMES=20
FALLBACK_LAT=10.5898
FALLBACK_LON=76.0116
VEHICLE_ID=BUS_001
