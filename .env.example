# ==========================================
# TRANS GUARD AI — Environment Variables
# ==========================================
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to version control.

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/transguard

# JWT secret for dashboard operator tokens (generate a strong random string)
JWT_SECRET=CHANGE_ME_generate_a_random_secret

# Default admin account credentials (used only for initial seeding in dev)
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_use_a_strong_password

# Edge node API key (must match the key configured on your Python engine instances)
DEFAULT_EDGE_API_KEY=CHANGE_ME_generate_a_random_key

# Server port
PORT=5000

# Environment: 'development' or 'production'
NODE_ENV=development

# CORS allowed origins (comma-separated, e.g. http://localhost:5173,https://yourdomain.com)
# Leave empty or unset to allow all origins in development
CORS_ORIGINS=

# (Optional) Experiential Labs / LLM integration
# EXPLABS_API_KEY=your_api_key_here
# OPENAI_BASE_URL=https://api.experientiallabs.ai/v1
# OPENAI_MODEL=gpt-6-astra
