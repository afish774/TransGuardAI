# ==========================================
# TRANS GUARD AI — Backend Environment Template
# ==========================================

# MongoDB Connection String
MONGO_URI=mongodb://127.0.0.1:27017/transguard

# JWT Authentication for Dashboard Operators
JWT_SECRET=your-secure-jwt-secret-here

# Default Edge Node API Key (seeded on first boot)
DEFAULT_EDGE_API_KEY=transguard-edge-secret-key-9042

# Server Port and Environment
PORT=5000
NODE_ENV=development

# ==========================================
# Edge Engine — AI Fusion Models
# ==========================================

# Primary detector (persons + baggage). Auto-downloaded by ultralytics.
YOLO_MODEL=yolov8n.pt
YOLO_CONF=0.45

# Pillar 4: secondary fine-tuned weapon detector. Place the .pt beside the
# engine. If the file is missing, weapon detection is skipped (engine still runs).
WEAPON_MODEL=yolov8n-weapons.pt
WEAPON_CONF=0.45

# Pillar 1: over-crowd density + temporal consensus
CROWD_THRESHOLD=10
CROWD_FRAMES=15
