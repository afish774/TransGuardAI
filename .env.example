# ==========================================
# TRANS GUARD AI — Backend Environment Template
# ==========================================

# MongoDB Connection String
MONGO_URI=mongodb://127.0.0.1:27017/transguard

# JWT Authentication for Dashboard Operators
JWT_SECRET=your-secure-jwt-secret-here

# Default Edge Node API Key (seeded on first boot)
DEFAULT_EDGE_API_KEY=transguard-edge-secret-key-9042

# Server Port and Environment
PORT=5000
NODE_ENV=development
